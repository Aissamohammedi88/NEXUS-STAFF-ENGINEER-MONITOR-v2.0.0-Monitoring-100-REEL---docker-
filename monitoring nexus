# ===============================================================
# ETAT GLOBAL & COLLECTE
# ===============================================================

ETAT = {
"demarre_a": time.time(),
"tick": 0,
"historique_cpu": collections.deque(maxlen=60),
"historique_ram": collections.deque(maxlen=60),
"historique_latence": collections.deque(maxlen=60),
"derniere_collecte": 0,
}
ETAT_LOCK = threading.RLock()


def collecter_service(svc):
"""Collecte l'etat REEL d'un service."""
resultat = {
"id": svc["id"],
"nom": svc["nom"],
"langage": svc["langage"],
"port": svc["port"],
"role": svc["role"],
"couleur": svc["couleur"],
"sources": [],
}

# 1. Test port TCP (reel)
port_info = verifier_port_tcp("127.0.0.1", svc["port"])
resultat["port_ouvert"] = port_info["ouvert"]
resultat["latence_port_ms"] = port_info["latence_ms"]
resultat["sources"].append("tcp_connect")

# 2. Docker stats (reel si docker dispo)
if DOCKER_DISPONIBLE:
stats = docker_container_stats(svc["container"])
if stats:
resultat["cpu_pct"] = stats["cpu_pct"]
resultat["ram_mo"] = stats["ram_mo"]
resultat["ram_pct"] = stats["ram_pct"]
resultat["net_io"] = stats["net_io"]
resultat["block_io"] = stats["block_io"]
resultat["sources"].append("docker_stats")

inspect = docker_container_inspect(svc["container"])
if inspect:
resultat["docker_status"] = inspect["status"]
resultat["docker_health"] = inspect["health"]
resultat["restart_count"] = inspect["restart_count"]
resultat["uptime_container_s"] = inspect["uptime_s"]
resultat["sources"].append("docker_inspect")

# 3. HTTP health check (reel)
if svc["health_url"]:
health = http_health_check(svc["health_url"])
if health:
resultat["http_status"] = health["status"]
resultat["http_ok"] = health["ok"]
resultat["http_latence_ms"] = health["latence_ms"]
resultat["http_reponse"] = health.get("reponse", "")[:200]
if "erreur" in health:
resultat["http_erreur"] = health["erreur"]
resultat["sources"].append("http_health")

# 4. Metriques Prometheus si dispo
if svc["health_url"]:
metrics_url = svc["health_url"].replace("/health", "/metrics")
metrics = http_metrics_scrape(metrics_url)
if metrics:
resultat["prometheus"] = metrics
resultat["sources"].append("prometheus")

# Calcul de la sante REELLE
if not resultat["port_ouvert"]:
resultat["sante"] = "KO"
resultat["raison_sante"] = "port ferme"
elif resultat.get("docker_status") and resultat["docker_status"] != "running":
resultat["sante"] = "KO"
resultat["raison_sante"] = "container non running"
elif resultat.get("http_ok") is False:
resultat["sante"] = "DEGRADEE"
resultat["raison_sante"] = "HTTP KO : " + resultat.get("http_erreur", "")
else:
resultat["sante"] = "OK"
resultat["raison_sante"] = "toutes verifications passees"

return resultat


def collecter_etat():
"""Collecte l'etat complet REEL du systeme."""
with ETAT_LOCK:
ETAT["tick"] += 1
tick = ETAT["tick"]

sysinfo = info_systeme()

# Systeme
cpu_sys = lire_cpu_systeme()
mem_sys = lire_mem_systeme()
disque = lire_disque()
uptime_sys = lire_uptime()
loadavg = lire_loadavg()
top_proc = lire_processus_top(5)

# Docker global
docker_containers = docker_ps_all() if DOCKER_DISPONIBLE else []
docker_info = docker_info_systeme() if DOCKER_DISPONIBLE else None

# Services
services_data = [collecter_service(svc) for svc in SERVICES]

# Agregat REEL
services_ok = sum(1 for s in services_data if s["sante"] == "OK")
services_ko = sum(1 for s in services_data if s["sante"] == "KO")
services_deg = sum(1 for s in services_data if s["sante"] == "DEGRADEE")
ports_ouverts = sum(1 for s in services_data if s["port_ouvert"])

# Metriques agregees (reelles)
cpu_moyen = 0.0
ram_total = 0.0
latence_moy = 0.0
services_avec_cpu = 0

for s in services_data:
if "cpu_pct" in s:
cpu_moyen += s["cpu_pct"]
services_avec_cpu += 1
if "ram_mo" in s:
ram_total += s["ram_mo"]
if "http_latence_ms" in s:
latence_moy += s["http_latence_ms"]

if services_avec_cpu > 0:
cpu_moyen = round(cpu_moyen / services_avec_cpu, 2)
if services_data:
latence_moy = round(latence_moy / len(services_data), 2)

with ETAT_LOCK:
ETAT["historique_cpu"].append(cpu_sys if cpu_sys is not None else 0)
ETAT["historique_ram"].append(mem_sys["pct"] if mem_sys else 0)
ETAT["historique_latence"].append(latence_moy)
ETAT["derniere_collecte"] = time.time()
hist_cpu = list(ETAT["historique_cpu"])
hist_ram = list(ETAT["historique_ram"])
hist_lat = list(ETAT["historique_latence"])

return {
"version": VERSION,
"auteur": AUTEUR,
"licence": LICENCE,
"timestamp": datetime.now(timezone.utc).isoformat(),
"uptime_s": int(time.time() - ETAT["demarre_a"]),
"tick": tick,
"systeme": sysinfo,
"docker": {
"disponible": DOCKER_DISPONIBLE,
"version": (docker_info or {}).get("ServerVersion") if docker_info else None,
"containers_total": len(docker_containers),
"containers": docker_containers[:20],
},
"ressources_systeme": {
"cpu_pct": cpu_sys,
"memoire": mem_sys,
"disque": disque,
"uptime_s": uptime_sys,
"loadavg": loadavg,
},
"top_processus": top_proc,
"services": services_data,
"agregat": {
"services_total": len(services_data),
"services_ok": services_ok,
"services_ko": services_ko,
"services_deg": services_deg,
"ports_ouverts": ports_ouverts,
"cpu_moyen": cpu_moyen,
"ram_total_mo": round(ram_total, 1),
"latence_moyenne_ms": latence_moy,
},
"historique": {
"cpu": hist_cpu,
"ram": hist_ram,
"latence": hist_lat,
},
}


