def executer_commande(cmd, timeout=5):
"""Execute une commande et retourne (code, stdout, stderr)."""
try:
r = subprocess.run(
cmd,
capture_output=True,
text=True,
timeout=timeout
)
return r.returncode, r.stdout or "", r.stderr or ""
except subprocess.TimeoutExpired:
return -1, "", "timeout"
except FileNotFoundError:
return -2, "", "commande introuvable"
except Exception as e:
return -3, "", str(e)[:200]


def commande_dispo(nom):
"""Verifie si une commande est disponible dans le PATH."""
return shutil.which(nom) is not None


def verifier_port_tcp(host, port, timeout=0.5):
"""Teste si un port TCP accepte les connexions."""
try:
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.settimeout(timeout)
t0 = time.time()
result = s.connect_ex((host, port))
dt = (time.time() - t0) * 1000
s.close()
return {
"ouvert": result == 0,
"latence_ms": round(dt, 2) if result == 0 else 0,
}
except Exception as e:
return {"ouvert": False, "latence_ms": 0, "erreur": str(e)[:80]}


# ===============================================================
# DOCKER STATS REELS
# ===============================================================

DOCKER_DISPONIBLE = commande_dispo("docker")


def docker_container_stats(nom_container):
"""
Recupere les stats reelles d'un container Docker.
Retourne CPU %, RAM Mo, etc. ou None si indisponible.
"""
if not DOCKER_DISPONIBLE:
return None

code, out, err = executer_commande(
["docker", "stats", "--no-stream", "--format",
"{{.CPUPerc}}|{{.MemUsage}}|{{.MemPerc}}|{{.NetIO}}|{{.BlockIO}}",
nom_container],
timeout=5
)

if code != 0 or not out.strip():
return None

try:
parties = out.strip().split("|")
if len(parties) < 5:
return None

cpu_str = parties[0].replace("%", "").strip()
mem_usage = parties[1].split("/")[0].strip()
mem_pct = parties[2].replace("%", "").strip()
net_io = parties[3].strip()
block_io = parties[4].strip()

# Parse CPU
try:
cpu_pct = float(cpu_str)
except ValueError:
cpu_pct = 0.0

# Parse RAM (format "123.4MiB" ou "1.5GiB" ou "256KiB")
ram_mo = 0.0
m = re.match(r"^([\d.]+)\s*([KMG]i?B)$", mem_usage, re.IGNORECASE)
if m:
val = float(m.group(1))
unite = m.group(2).upper()
if unite in ("KIB", "KB"):
ram_mo = val / 1024
elif unite in ("MIB", "MB"):
ram_mo = val
elif unite in ("GIB", "GB"):
ram_mo = val * 1024

try:
mem_pct_val = float(mem_pct)
except ValueError:
mem_pct_val = 0.0

return {
"cpu_pct": round(cpu_pct, 2),
"ram_mo": round(ram_mo, 1),
"ram_pct": round(mem_pct_val, 2),
"net_io": net_io,
"block_io": block_io,
"source": "docker_stats",
}
except Exception as e:
log("Erreur parse docker stats " + nom_container + " : " + str(e)[:80], "WARN")
return None


def docker_container_inspect(nom_container):
"""Verifie si un container existe et son etat."""
if not DOCKER_DISPONIBLE:
return None

code, out, err = executer_commande(
["docker", "inspect", "--format",
"{{.State.Status}}|{{.State.StartedAt}}|{{.RestartCount}}|{{.State.Health.Status}}",
nom_container],
timeout=5
)

if code != 0:
return None

try:
parties = out.strip().split("|")
if len(parties) < 3:
return None

status = parties[0]
started_at = parties[1]
restart_count = int(parties[2]) if parties[2].isdigit() else 0
health = parties[3] if len(parties) > 3 else "unknown"

# Uptime
uptime_s = 0
try:
start_dt = datetime.fromisoformat(started_at.replace("Z", "+00:00"))
uptime_s = int((datetime.now(timezone.utc) - start_dt).total_seconds())
except Exception:
pass

return {
"status": status,
"health": health,
"restart_count": restart_count,
"uptime_s": uptime_s,
"started_at": started_at,
}
except Exception as e:
log("Erreur inspect " + nom_container + " : " + str(e)[:80], "WARN")
return None


def docker_ps_all():
"""Liste tous les containers Docker reels."""
if not DOCKER_DISPONIBLE:
return []
code, out, err = executer_commande(
["docker", "ps", "-a", "--format",
"{{.Names}}|{{.Status}}|{{.Image}}|{{.Ports}}"],
timeout=5
)
if code != 0:
return []
resultats = []
for ligne in out.strip().split("\n"):
if not ligne.strip():
continue
parties = ligne.split("|")
if len(parties) >= 4:
resultats.append({
"nom": parties[0],
"status": parties[1],
"image": parties[2],
"ports": parties[3],
})
return resultats


def docker_info_systeme():
"""Recupere l'info systeme Docker."""
if not DOCKER_DISPONIBLE:
return None
code, out, err = executer_commande(
["docker", "info", "--format", "{{json .}}"],
timeout=10
)
if code != 0:
return None
try:
return json.loads(out)
except Exception:
return None


