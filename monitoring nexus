function renderChart(hist){
if(!hist || !hist.cpu || hist.cpu.length < 2) return;
var W = 400, H = 100;
var n = hist.cpu.length;
var maxCpu = Math.max.apply(null, hist.cpu) || 100;
var maxRam = Math.max.apply(null, hist.ram) || 100;
var maxLat = Math.max.apply(null, hist.latence) || 100;
if(maxCpu === 0) maxCpu = 1;
if(maxRam === 0) maxRam = 1;
if(maxLat === 0) maxLat = 1;

var cpuPts = [], ramPts = [], latPts = [];
hist.cpu.forEach(function(v, i){
var x = (i / (n-1)) * W;
cpuPts.push(x.toFixed(1)+','+(H - (v/maxCpu)*H).toFixed(1));
ramPts.push(x.toFixed(1)+','+(H - (hist.ram[i]/maxRam)*H).toFixed(1));
latPts.push(x.toFixed(1)+','+(H - (hist.latence[i]/maxLat)*H).toFixed(1));
});
document.getElementById('line-cpu').setAttribute('points', cpuPts.join(' '));
document.getElementById('line-ram').setAttribute('points', ramPts.join(' '));
document.getElementById('line-lat').setAttribute('points', latPts.join(' '));
}

