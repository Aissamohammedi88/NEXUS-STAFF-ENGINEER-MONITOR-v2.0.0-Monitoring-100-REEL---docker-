# LECTURE SYSTEME REELLE (Linux)
# ===============================================================

def lire_cpu_systeme():
"""Lit l'utilisation CPU reelle du systeme."""
try:
with open("/proc/stat", "r") as f:
lignes = f.readlines()
for ligne in lignes:
if ligne.startswith("cpu "):
parts = ligne.split()
if len(parts) >= 5:
user = int(parts[1])
nice = int(parts[2])
system = int(parts[3])
idle = int(parts[4])
total = user + nice + system + idle
if total > 0:
return round((total - idle) / total * 100, 2)
except Exception:
pass
return None


def lire_mem_systeme():
"""Lit la memoire systeme reelle."""
try:
with open("/proc/meminfo", "r") as f:
mem = {}
for ligne in f:
if ":" in ligne:
k, v = ligne.split(":", 1)
mem[k.strip()] = v.strip()
total = int(mem.get("MemTotal", "0").split()[0]) / 1024
dispo = int(mem.get("MemAvailable", "0").split()[0]) / 1024
utilise = total - dispo
pct = (utilise / total * 100) if total > 0 else 0
return {
"total_mo": round(total, 1),
"utilise_mo": round(utilise, 1),
"dispo_mo": round(dispo, 1),
"pct": round(pct, 2),
}
except Exception:
return None


def lire_disque():
"""Lit l'utilisation disque reelle."""
try:
st = os.statvfs("/")
total = st.f_blocks * st.f_frsize
libre = st.f_bavail * st.f_frsize
utilise = total - libre
pct = (utilise / total * 100) if total > 0 else 0
return {
"total_go": round(total / (1024**3), 2),
"utilise_go": round(utilise / (1024**3), 2),
"libre_go": round(libre / (1024**3), 2),
"pct": round(pct, 2),
}
except Exception:
return None


def lire_uptime():
"""Lit l'uptime systeme reel."""
try:
with open("/proc/uptime", "r") as f:
return int(float(f.read().split()[0]))
except Exception:
return None


def lire_loadavg():
"""Lit le load average reel."""
try:
with open("/proc/loadavg", "r") as f:
parts = f.read().split()
return [float(parts[0]), float(parts[1]), float(parts[2])]
except Exception:
return None


def lire_processus_top(n=5):
"""Lit les top processus par CPU."""
try:
code, out, err = executer_commande(
["ps", "aux", "--sort=-%cpu"],
timeout=5
)
if code != 0:
return []
processus = []
for ligne in out.split("\n")[1:n+1]:
parties = ligne.split(None, 10)
if len(parties) >= 11:
try:
processus.append({
"user": parties[0],
"pid": parties[1],
"cpu": float(parties[2]),
"ram": float(parties[3]),
"commande": parties[10][:80],
})
except ValueError:
continue
return processus
except Exception:
return []


