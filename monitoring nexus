def http_health_check(url, timeout=3):
"""Effectue un vrai GET sur l'endpoint de sante."""
if not url:
return None
t0 = time.time()
try:
req = urllib.request.Request(url, headers={"User-Agent": "NexusMonitor/2.0"})
with urllib.request.urlopen(req, timeout=timeout, context=CTX) as r:
dt = (time.time() - t0) * 1000
body = r.read(4096).decode("utf-8", "ignore")
return {
"ok": True,
"status": r.status,
"latence_ms": round(dt, 2),
"reponse": body[:500],
}
except urllib.error.HTTPError as e:
dt = (time.time() - t0) * 1000
return {
"ok": False,
"status": e.code,
"latence_ms": round(dt, 2),
"erreur": "HTTP " + str(e.code),
}
except Exception as e:
dt = (time.time() - t0) * 1000
return {
"ok": False,
"status": 0,
"latence_ms": round(dt, 2),
"erreur": str(e)[:100],
}


def http_metrics_scrape(url, timeout=3):
"""Scrape un endpoint /metrics Prometheus."""
if not url:
return None
try:
req = urllib.request.Request(url, headers={"User-Agent": "NexusMonitor/2.0"})
with urllib.request.urlopen(req, timeout=timeout, context=CTX) as r:
body = r.read(100000).decode("utf-8", "ignore")
# Parse les metriques simples
metriques = {}
for ligne in body.split("\n"):
if ligne.startswith("#") or not ligne.strip():
continue
m = re.match(r"^([a-zA-Z_:][a-zA-Z0-9_:]*)\s+([\d.eE+-]+)", ligne)
if m:
try:
metriques[m.group(1)] = float(m.group(2))
except ValueError:
pass
return metriques
except Exception:
return None


